# ============================================================================
# ONE2LVOS PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual API keys
# Deploy Date: 2026-09-08
# Version: 1.0.2-production

# ============================================================================
# ASTRA DB VECTOR MEMORY (DataStax) - NVIDIA Vectorize Integration
# ============================================================================
# Get credentials from: https://astra.datastax.com/
ASTRA_DB_API_ENDPOINT=https://YOUR-DB-ID-REGION.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:YOUR_APPLICATION_TOKEN
ASTRA_DB_KEYSPACE=sovereign_memory

# NVIDIA Embedding Provider (Managed by Astra - No API key needed for hosted integration)
# Model: nvidia/nv-embed-v2 (4096 dimensions, optimized for semantic retrieval)
ASTRA_NVIDIA_MODEL=nvidia/nv-embed-v2
ASTRA_VECTOR_METRIC=cosine

# ============================================================================
# SUPABASE CONFIGURATION (Backup/Sync)
# ============================================================================
# Get credentials from: https://supabase.com/dashboard
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@YOUR-HOST.pooler.supabase.com:6543/postgres

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=8787
NODE_PORT=8787
PYTHON_PORT=3002
NGINX_PORT=80
NODE_ENV=production

# ============================================================================
# NVIDIA AI API KEYS (Multiple models/endpoints)
# ============================================================================
# Get API keys from: https://build.nvidia.com/explore/discover
# Primary Nemotron Super (70B instruct)
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY

# Secondary Llama-3.1 Nemotron 70B
NVIDIA_API_KEY_SECONDARY=nvapi-YOUR_SECONDARY_KEY

# Nemotron Super (Step-1 405B)
NVIDIA_API_KEY_NEMOTRON_SUPER=nvapi-YOUR_NEMOTRON_KEY

# MiniMax (Abab-6.5)
NVIDIA_API_KEY_MINIMAX=nvapi-YOUR_MINIMAX_KEY

# StepFun (Step-2 16K)
NVIDIA_API_KEY_STEPFUN=nvapi-YOUR_STEPFUN_KEY

# Kimi (Moonshot-v1-128K)
NVIDIA_API_KEY_KIMI=nvapi-YOUR_KIMI_KEY

# NVIDIA API Endpoint (OpenAI Compatible)
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1

# ============================================================================
# GEMINI AI (Google Generative AI)
# ============================================================================
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_CLIENT_ID=YOUR_GEMINI_CLIENT_ID
GEMINI_AGENT_NAME=Astra
GEMINI_MODEL=gemini-pro
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# ============================================================================
# MATON API (Task Automation)
# ============================================================================
# Get API key from: https://maton.ai/settings
MATON_API_KEY=YOUR_MATON_API_KEY

# ============================================================================
# STEAM WEB API (Lumenis Gaming Integration)
# ============================================================================
# Get API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=YOUR_STEAM_API_KEY
STEAM_DOMAIN=https://github.com/one2lv-com/Lumenis.io

# ============================================================================
# PYTHON BACKEND (FastAPI Sovereign Council)
# ============================================================================
PYTHON_API_URL=http://one2lvos-python:3002
PYTHON_HOST=0.0.0.0

# ============================================================================
# NODE FRONTEND (AI Lobby)
# ============================================================================
NODE_API_URL=http://one2lvos-node:8787
NODE_HOST=0.0.0.0

# ============================================================================
# CORS & SECURITY
# ============================================================================
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8787,http://localhost:3002
CORS_ENABLED=true

# ============================================================================
# ONE2LVOS SYSTEM
# ============================================================================
O2PNG_VERSION=1.0
SNAPSHOT_AUTO_SAVE=true
SNAPSHOT_INTERVAL=300000
RECOVERY_MODE=transactional
BOOT_TIMEOUT=30000

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# DOCKER COMPOSE SERVICES
# ============================================================================
COMPOSE_PROJECT_NAME=one2lvos
RESTART_POLICY=unless-stopped

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
