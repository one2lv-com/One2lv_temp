# ============================================================================
# ONE2LVOS SOVEREIGN ARCHITECTURE - MASTER .ENV TEMPLATE
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual credentials
# This template file should NOT contain real secrets
# ============================================================================

# ---------------------------------------------------------------------------
# L1 MEMORY: Astra DB Vector Memory (DataStax)
# ---------------------------------------------------------------------------
# Get your credentials from: https://astra.datastax.com
ASTRA_DB_API_ENDPOINT=your_astra_db_endpoint_here
ASTRA_DB_APPLICATION_TOKEN=your_astra_db_token_here
ASTRA_DB_KEYSPACE=one2lvOS
COLLECTION_NAME=aria_memory_v2
VECTOR_DIM=2048

# ---------------------------------------------------------------------------
# LUMENIS REACTOR: NVIDIA AI Models (Council of Nine - Fully NVIDIA Powered)
# ---------------------------------------------------------------------------
# PRIMARY: NVIDIA Nemotron-Super-49B (Main reactor + most council seats)
# SECONDARY: NVIDIA Gemma-4-31B-IT (Forge & Oracle seats)
# Get your key from: https://build.nvidia.com/explore/discover
# ---------------------------------------------------------------------------
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_KEY_SECONDARY=your_nvidia_api_key_here
NVIDIA_API_KEY_NEMOTRON_SUPER=your_nvidia_api_key_here
NVIDIA_API_KEY_MINIMAX=your_nvidia_api_key_here
NVIDIA_API_KEY_STEPFUN=your_nvidia_api_key_here
NVIDIA_API_KEY_KIMI=your_nvidia_api_key_here

# ---------------------------------------------------------------------------
# EXTERNAL GATEWAYS: Discord & Twitch (Optional)
# ---------------------------------------------------------------------------
# Get Discord bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_APPLICATION_ID=your_application_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
TWITCH_BOT_USERNAME=your_twitch_username
TWITCH_OAUTH_TOKEN=your_twitch_oauth_token_here
TWITCH_CHANNEL=your_twitch_channel

# ---------------------------------------------------------------------------
# DATABASE: Supabase (Optional)
# ---------------------------------------------------------------------------
# Get credentials from: https://supabase.com
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
DATABASE_URL=your_database_url_here

# ---------------------------------------------------------------------------
# OTHER SERVICES & GATEWAYS
# ---------------------------------------------------------------------------
# Maton API for external service integration
MATON_API_KEY=your_maton_api_key_here
# GitHub token for repository operations
GITHUB_TOKEN=your_github_token_here

# ---------------------------------------------------------------------------
# SERVER & ROUTING CONFIGURATION
# ---------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
PYTHON_API_URL=http://localhost:3002
